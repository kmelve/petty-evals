{
  "name": "petty-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rigorous benchmarks for problems that don't matter.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "evals": "node --env-file-if-exists=.env --experimental-strip-types scripts/run-evals.ts",
    "evals:pundits": "node --env-file-if-exists=.env --experimental-strip-types scripts/rerun-pundits.ts",
    "evals:reclassify": "node --env-file-if-exists=.env --experimental-strip-types scripts/reclassify.ts",
    "models:popular": "node --env-file-if-exists=.env --experimental-strip-types scripts/popular-models.ts",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@openrouter/ai-sdk-provider": "2.9.0",
    "@tailwindcss/vite": "4.3.0",
    "ai": "6.0.196",
    "astro": "6.4.4",
    "astro-og-canvas": "0.11.1",
    "canvaskit-wasm": "^0.41.1",
    "p-limit": "7.3.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.6.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  }
}
