{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "jsx": "preserve",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    ".astro/types.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}