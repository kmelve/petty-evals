---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const {
  title,
  description = 'I made AI coding models review each other on petty dev debates. Tabs vs spaces, === vs ==, semicolons. They were not nice about it.',
  ogImage = '/og/home.png',
} = Astro.props;

const site = Astro.site ?? new URL('https://pettyevals.dev');
const ogUrl = new URL(ogImage, site).href;
const canonical = new URL(Astro.url.pathname, site).href;
const path = Astro.url.pathname;
const tabs = [
  { href: '/', label: 'Fights', active: path === '/' || path.startsWith('/fights') },
  { href: '/beef', label: 'Beef', active: path.startsWith('/beef') },
  { href: '/methodology', label: 'Methodology', active: path.startsWith('/methodology') },
];
---
<!DOCTYPE html>
<html lang="en" class="antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400..700&family=Mona+Sans:wdth,wght@75..125,200..900&display=swap" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Petty Evals" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <header class="border-b border-zinc-200 bg-zinc-50 px-6 pt-4 md:px-10">
      <div class="mx-auto flex max-w-5xl flex-col gap-3">
        <a href="/" class="flex w-fit items-center gap-2 text-lg">
          <svg viewBox="0 0 24 24" class="size-5 text-zinc-500" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="6" cy="5" r="2.25" /><circle cx="6" cy="19" r="2.25" /><circle cx="18" cy="12" r="2.25" />
            <path d="M6 7.25v9.5M8 5h4a4 4 0 0 1 4 4v.75" stroke-linecap="round" />
          </svg>
          <span class="text-zinc-600">kmelve</span>
          <span class="text-zinc-400">/</span>
          <span class="font-semibold text-zinc-950">petty-evals</span>
        </a>
        <nav class="-mb-px flex gap-1 overflow-x-auto" aria-label="Main">
          {tabs.map((tab) => (
            <a
              href={tab.href}
              class:list={[
                'border-b-2 px-3 py-2 text-sm font-medium whitespace-nowrap',
                tab.active ? 'border-rose-500 text-zinc-950' : 'border-transparent text-zinc-600 hover:border-zinc-300 hover:text-zinc-950',
              ]}
              aria-current={tab.active ? 'page' : undefined}
            >{tab.label}</a>
          ))}
          <a href="https://github.com/kmelve/petty-evals" class="ml-auto border-b-2 border-transparent px-3 py-2 text-sm font-medium whitespace-nowrap text-zinc-600 hover:text-zinc-950">Source ↗</a>
        </nav>
      </div>
    </header>

    <main class="isolate flex-1 px-6 py-10 md:px-10">
      <div class="mx-auto max-w-5xl">
        <slot />
      </div>
    </main>

    <footer class="border-t border-zinc-200 px-6 py-8 md:px-10">
      <div class="mx-auto flex max-w-5xl flex-col justify-between gap-2 text-sm text-zinc-600 sm:flex-row">
        <p>Rigorous benchmarks for problems that don't matter.</p>
        <p>Made by <a href="https://github.com/kmelve" class="font-medium text-zinc-900 hover:text-sky-700">@kmelve</a>. Models called via OpenRouter.</p>
      </div>
    </footer>
  </body>
</html>
