---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import VoteCard from '../../components/VoteCard.astro';
import PunditCard from '../../components/PunditCard.astro';
import Receipts from '../../components/Receipts.astro';

export async function getStaticPaths() {
  const fights = await getCollection('fights');
  return fights.map((f) => ({ params: { slug: f.id }, props: { fight: f } }));
}

const { fight } = Astro.props;
const slug = fight.id;

// Lazy-load the results JSON for this fight via Vite glob.
const allResults = import.meta.glob('../../data/results/*.json', { eager: true }) as Record<string, { default: any }>;
const resultEntry = Object.entries(allResults).find(([path]) => path.endsWith(`/${slug}.json`));
const result = resultEntry ? (resultEntry[1] as any).default : null;

function verdictSubtitle(tally: Record<string, number>, total: number): string {
  const values = Object.values(tally);
  const max = Math.max(...values);
  const topCount = values.filter(v => v === max).length;
  if (max === total) return 'Unanimous. Anyone disagreeing with this in 2026 needs to log off.';
  if (max === total - 1) return 'Three against one. The dissenter is about to be put on blast.';
  if (max === 2 && topCount > 1) return 'It is a TIE. Two against two. They are throwing hands below.';
  return 'A real fight. Scroll for the dunks.';
}

function tallyString(tally: Record<string, number>): string {
  return Object.entries(tally).map(([k, v]) => `${v} ${k}`).join(' · ');
}
function tallyTotal(tally: Record<string, number>): number {
  return Object.values(tally).reduce((a, b) => a + b, 0);
}

const winnerLabel = result ? result.verdict.winner.toUpperCase() : '?';
const tallyParts = result ? tallyString(result.verdict.tally) : '';
const totalVoters = result ? tallyTotal(result.verdict.tally) : 0;
---
<Base
  title={`${fight.data.title} — Petty Evals`}
  description={fight.data.question}
  ogImage={`/og/${slug}.png`}
>
  <div class="mb-3">
    <span class="sticker sticker--blue">{fight.data.category ?? 'formatting'}</span>
  </div>
  <h1 class="display text-5xl md:text-7xl mb-8 max-w-3xl">
    {fight.data.title.replace(/[?.]$/, '')}<span style="color: var(--color-coral);">?</span>
  </h1>

  {result && (
    <div class="mb-16">
      <div class="display text-7xl md:text-9xl" style="color: var(--color-coral);">
        {winnerLabel}
      </div>
      <div class="display text-3xl md:text-4xl mt-3">
        {tallyParts}
      </div>
      <p class="mt-4 max-w-2xl text-lg" style="color: var(--color-muted);">
        {verdictSubtitle(result.verdict.tally, totalVoters)}
      </p>
    </div>
  )}

  <section class="mb-12">
    <details class="accordion">
      <summary>The exact prompts I used ({fight.data.promptVariants.length} variants)</summary>
      <div class="pb-6 pt-2">
        <p class="text-sm mb-4 max-w-2xl" style="color: var(--color-muted);">
          Each model got each prompt 20 times (2 temperatures × 10 runs). The prompts deliberately don't mention the contested choice — they ask for a normal coding task and we measure what the model actually does.
        </p>
        <ol class="space-y-3 list-decimal pl-6">
          {fight.data.promptVariants.map((p: string) => (
            <li class="leading-relaxed">
              <code class="text-sm">{p}</code>
            </li>
          ))}
        </ol>
      </div>
    </details>
  </section>

  {result && (
    <section class="mb-16">
      <h2 class="display text-3xl mb-5">Who said what</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {result.models.map((m: any) => <VoteCard model={m} />)}
      </div>
    </section>
  )}

  {result && (
    <section class="mb-16">
      <h2 class="display text-3xl md:text-4xl mb-2">The pundit panel.</h2>
      <p class="text-base mb-6 max-w-2xl" style="color: var(--color-muted);">
        I showed each model the full vote tally, then asked them to defend their choice and
        dunk on whoever disagreed. Receipts attached.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {result.models.map((m: any) => <PunditCard model={m} />)}
      </div>
    </section>
  )}

  {result && (
    <section class="mb-16">
      <details class="accordion">
        <summary>Show me the actual code ({result.totalRuns} samples)</summary>
        <div class="pb-6">
          <Receipts models={result.models} />
        </div>
      </details>

      <details class="accordion">
        <summary>How I did this (the actual nerd shit)</summary>
        <div class="pb-8 prose">
          <p>
            For each of {result.models.length} models I ran <strong>{fight.data.promptVariants.length} prompt variants</strong>
            at <strong>two temperatures</strong> (0.0 and 0.7), <strong>10 runs each</strong> —
            {result.totalRuns} code samples total, cost <strong>${result.totalCostUsd.toFixed(2)}</strong>.
          </p>
          <p>
            Each output got fed through a <a href={'https://github.com/kmelve/petty-evals/blob/main/src/lib/eval/classifiers/regex.ts'}>fight-specific regex classifier</a>.
            For <code>{fight.id}</code> the classifier looks for the specific signal in the output
            (see the source — there's one function per fight, ~30 lines each).
            When the signal is ambiguous, the classifier returns <code>'unknown'</code> rather than guess.
          </p>
          <p>
            Each model's <strong>vote</strong> = its modal classification across 60 runs.
            <strong>Confidence</strong> = Wilson 95% CI.
            <strong>Verdict</strong> = majority across models (ties reported as ties).
            <strong>Disagreement Index</strong> = normalized Shannon entropy of the vote distribution
            (0 = unanimous, 1 = maximum chaos). Leaderboard sorts by this.
          </p>
          <p>
            The pundit quotes come from a follow-up call after the votes are in — each model gets
            the full tally and a per-model judgy prompt. I never edit the quotes.
          </p>
          <p>
            Full walkthrough: <a href="/methodology">the methodology page</a>. Source: <a href="https://github.com/kmelve/petty-evals">GitHub</a>.
          </p>
        </div>
      </details>
    </section>
  )}

  <section class="my-16 chunky chunky--coral p-8 md:p-10">
    <div class="display text-3xl md:text-4xl mb-3">Got a pettier debate?</div>
    <p class="text-lg mb-5 max-w-xl">
      Open a PR with a new fight. I'll run it across all four models, write up the verdict,
      and add your name to the byline.
    </p>
    <a href="https://github.com/kmelve/petty-evals/blob/main/CONTRIBUTING.md" class="sticker">
      Submit via PR →
    </a>
  </section>
</Base>
