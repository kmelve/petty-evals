---
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import StatusPill from '../../components/StatusPill.astro';
import InlineCode from '../../components/InlineCode.astro';
import ReviewComment from '../../components/ReviewComment.astro';
import Receipts from '../../components/Receipts.astro';
import VoteStrip from '../../components/VoteStrip.astro';
import { getCollection } from 'astro:content';
import { summarize, prettyLabel, modelName } from '../../lib/site/fight-summary.ts';
import { RANK_BG, rankText, prStatus } from '../../lib/site/review.ts';

export async function getStaticPaths() {
  const fights = await getCollection('fights');
  const results = await getCollection('results');
  return fights.map((f) => ({
    params: { slug: f.id },
    props: { fight: f, result: results.find((r) => r.data.slug === f.id)?.data ?? null },
  }));
}

const { fight, result } = Astro.props;
const slug = fight.id;
const title = fight.data.title.replace(/[?.]$/, '');
const summary = result ? summarize({ ...result, slug, sides: fight.data.sides }) : null;
const rankOf = new Map(summary?.segments.map((s) => [s.modelId, s.rank]) ?? []);

// Dissent first: the losing side's reviews are the ones people screenshot.
const reviews = result
  ? [...result.models]
      .map((m) => ({ ...m, name: modelName(m), rank: rankOf.get(m.id) ?? 0 }))
      .sort((a, b) => b.rank - a.rank || a.name.localeCompare(b.name))
  : [];

const runsPerPrompt = result ? Math.round(result.totalRuns / Math.max(1, result.models.length) / fight.data.promptVariants.length) : 0;
const runDate = result ? new Date(result.runFinishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }) : null;
const description = (summary
  ? `${prettyLabel(summary.winner)} ${summary.score}. ${summary.headline} ${fight.data.question}`
  : fight.data.question
).replace(/`/g, '');
---
<Base title={`${title.replace(/`/g, '')}? · Petty Evals`} description={description} ogImage={`/og/${slug}.png`}>
  <!-- PR header -->
  <div class="mb-8 flex flex-col gap-4 border-b border-zinc-200 pb-6">
    <h1 class="max-w-[30ch] font-wide text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      <InlineCode text={title} />? <span class="font-normal text-zinc-400">#{slug}</span>
    </h1>
    <div class="flex flex-wrap items-center gap-3 text-sm text-zinc-600">
      {summary ? <StatusPill mode={summary.mode} /> : <span class="rounded-full bg-zinc-100 px-2.5 py-1 font-medium text-zinc-700">Awaiting review</span>}
      <p>
        <span class="font-medium text-zinc-900">{fight.data.submittedBy}</span> opened this argument
        {result && <> · {result.models.length} reviewers · {result.totalRuns.toLocaleString('en-US')} samples · ${result.totalCostUsd.toFixed(2)} · run {runDate}</>}
      </p>
    </div>
  </div>

  {result && (
    <section class="mb-10 flex flex-col gap-3 rounded-lg bg-zinc-950 p-5 text-white sm:flex-row sm:items-center sm:justify-between md:p-6" aria-labelledby="pick-heading">
      <div class="flex flex-col gap-1">
        <h2 id="pick-heading" class="text-lg font-semibold tracking-tight">Which side are you on?</h2>
        <p class="text-sm text-zinc-400">Pick before you scroll. You get a card to share either way.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        {fight.data.sides.map((s: { label: string; name: string }) => (
          <a href={`/fights/${slug}/${s.label}`} class="rounded-md bg-white px-4 py-2.5 text-sm font-medium text-zinc-950 hover:bg-zinc-200">
            <span class:list={[/[^A-Za-z0-9 '-]/.test(s.name) && 'font-mono']}>{s.name}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <div class="flex min-w-0 flex-col gap-8">
      <!-- Description -->
      <article class="overflow-hidden rounded-lg border border-zinc-200">
        <header class="border-b border-zinc-200 bg-zinc-50 px-4 py-2.5 text-sm text-zinc-600">
          <span class="font-semibold text-zinc-900">{fight.data.submittedBy}</span> commented
        </header>
        <div class="flex flex-col gap-4 px-4 py-4">
          <p class="text-lg text-pretty text-zinc-900"><InlineCode text={fight.data.question} /></p>
          <p class="text-pretty text-zinc-600">
            I never asked the models what they prefer (they'd just tell me what I wanted to hear). Each one got these prompts{runsPerPrompt > 0 ? ` ${runsPerPrompt} times` : ''}, and a classifier counted what the code actually did:
          </p>
          {fight.data.disclosure && (
            <p class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-pretty text-amber-900">{fight.data.disclosure}</p>
          )}
          <ol class="flex list-decimal flex-col gap-2 pl-6 text-zinc-800">
            {fight.data.promptVariants.map((p: string) => <li><code class="font-mono text-sm">{p}</code></li>)}
          </ol>
        </div>
      </article>

      <!-- Verdict box -->
      {summary && result && (
        <section class:list={['flex flex-col gap-4 rounded-lg border-2 p-5', summary.mode === 'unanimous' || summary.mode === 'lone-dissent' ? 'border-emerald-500' : summary.mode === 'majority' ? 'border-amber-400' : 'border-rose-500']}>
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <p class="font-wide text-4xl font-semibold tracking-tight sm:text-5xl">{summary.winnerName}</p>
            <p class="font-mono text-3xl font-semibold tabular-nums">{summary.score}</p>
          </div>
          <VoteStrip segments={summary.segments} colors={[...RANK_BG]} class="h-3 gap-1" segmentClass="rounded-sm" />
          <p class="text-pretty text-zinc-700">{summary.headline}</p>
          <ul role="list" class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {summary.labels.map((l, i) => (
              <li class:list={['font-medium', rankText(i)]}>{prettyLabel(l.label)}: {l.count}</li>
            ))}
          </ul>
        </section>
      )}

      <!-- Reviews -->
      {reviews.length > 0 && summary && (
        <section class="flex flex-col gap-5">
          <h2 class="text-xl font-semibold tracking-tight">Reviews</h2>
          <p class="-mt-3 max-w-[62ch] text-pretty text-zinc-600">Each model saw the tally and got one sentence to react. I haven't edited them, and I take no responsibility for them.</p>
          {reviews.map((m) => (
            <ReviewComment slug={slug} fightTitle={`${title.replace(/`/g, '')}?`} model={m} winner={summary.winner} rank={m.rank} />
          ))}
        </section>
      )}

      <!-- Files changed -->
      {result && (
        <section class="flex flex-col gap-4">
          <h2 class="text-xl font-semibold tracking-tight">Files changed <span class="font-normal text-zinc-500">· the receipts</span></h2>
          <Receipts models={result.models} slug={slug} />
        </section>
      )}
    </div>

    <!-- Sidebar -->
    <aside class="flex flex-col gap-6 text-sm lg:sticky lg:top-6 lg:self-start">
      {summary && result && (
        <div class="flex flex-col gap-3">
          <h2 class="font-semibold text-zinc-900">Reviewers</h2>
          <ul role="list" class="flex flex-col gap-2.5">
            {summary.segments.map((s) => {
              const m = result.models.find((x) => x.id === s.modelId)!;
              return (
                <li>
                  <a href={`#review-${s.modelId}`} class="flex items-center gap-2.5 hover:text-sky-700">
                    <Avatar name={s.name} rank={s.rank} />
                    <span class="flex-1 truncate">{m.displayName}</span>
                    <span class:list={['font-mono', rankText(s.rank)]}>{prettyLabel(s.vote)}</span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      )}
      <div class="flex flex-col gap-2 border-t border-zinc-200 pt-5">
        <h2 class="font-semibold text-zinc-900">Labels</h2>
        <p><span class="rounded-full bg-sky-50 px-2 py-0.5 text-sky-700 ring-1 ring-sky-600/20 ring-inset">{fight.data.category}</span></p>
      </div>
      {summary && (
        <div class="flex flex-col gap-2 border-t border-zinc-200 pt-5">
          <h2 class="font-semibold text-zinc-900">Status</h2>
          <p class="text-zinc-600">{prStatus(summary.mode).label}. Disagreement index {result!.verdict.disagreementIndex.toFixed(2)} (0 = unanimous, 1 = chaos).</p>
          <a href="/methodology" class="font-medium text-sky-700 hover:underline">How this is measured</a>
        </div>
      )}
    </aside>
  </div>

  <script>
    // "Copy link" on review comments: copy the permalink, fall back to following the anchor.
    document.addEventListener('click', async (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-copy]');
      if (!link || !navigator.clipboard) return;
      event.preventDefault();
      try {
        await navigator.clipboard.writeText(link.dataset.copy!);
        const original = link.textContent;
        link.textContent = 'Copied';
        setTimeout(() => (link.textContent = original), 1500);
      } catch {
        window.location.hash = link.hash;
      }
    });
  </script>
</Base>
