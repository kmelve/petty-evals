---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const fights = await getCollection('fights');
const allResults = import.meta.glob('../data/results/*.json', { eager: true }) as Record<string, { default: any }>;
const resultsBySlug: Record<string, any> = {};
for (const [path, mod] of Object.entries(allResults)) {
  const slug = path.split('/').pop()!.replace('.json', '');
  resultsBySlug[slug] = mod.default;
}

function tallyString(tally: Record<string, number>): string {
  return Object.entries(tally).map(([k, v]) => `${v} ${k}`).join(' · ');
}

const items = fights.map((f) => {
  const r = resultsBySlug[f.id];
  return {
    slug: f.id,
    title: f.data.title,
    question: f.data.question,
    category: f.data.category ?? 'formatting',
    verdict: r?.verdict,
    verdictTally: r?.verdict ? tallyString(r.verdict.tally) : '',
    disagreement: r?.verdict?.disagreementIndex ?? 0,
    totalRuns: r?.totalRuns ?? 0,
  };
}).sort((a, b) => (b.disagreement ?? 0) - (a.disagreement ?? 0));
---
<Base title="Petty Evals — rigorous benchmarks for problems that don't matter">
  <section class="mb-16">
    <h1 class="display text-5xl md:text-7xl mb-5 max-w-3xl">
      I made four AIs <span style="color: var(--color-coral);">fight</span><br>
      about petty dev debates.
    </h1>
    <p class="text-lg md:text-xl max-w-2xl mb-7" style="color: var(--color-muted);">
      Tabs or spaces? <code>===</code> or <code>==</code>? <code>let</code> or <code>const</code>?
      I made <a href="/methodology" class="styled">the AIs actually write code</a>, then I measured
      what they did. The receipts are below. Each fight is real data, not vibes.
    </p>
    <div class="flex gap-3 flex-wrap">
      <a href="#fights" class="sticker">See the fights</a>
      <a href="/methodology" class="sticker sticker--blue">How I did it</a>
    </div>
  </section>

  <section id="fights" class="mb-16">
    <div class="flex items-end justify-between mb-6 border-b-2 pb-3" style="border-color: var(--color-ink);">
      <h2 class="display text-3xl">The fights</h2>
      <span class="text-sm" style="color: var(--color-muted);">
        sorted by Disagreement Index
      </span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {items.map((item) => (
        <a href={`/fights/${item.slug}`} class="chunky p-5 block transition-transform hover:-translate-y-1">
          <div class="text-xs font-mono mb-2" style="color: var(--color-muted);">
            {item.category} · {item.totalRuns} samples
          </div>
          <div class="display text-2xl mb-3 leading-tight">
            {item.title.replace(/[?.]$/, '')}<span style="color: var(--color-coral);">?</span>
          </div>
          {item.verdict ? (
            <div class="display text-xl" style="color: var(--color-coral);">
              {item.verdict.winner.toUpperCase()}
              <span class="text-sm font-normal" style="color: var(--color-ink); font-family: var(--font-body);">
                · {item.verdictTally}
              </span>
            </div>
          ) : (
            <div class="text-sm" style="color: var(--color-muted);">pending data</div>
          )}
        </a>
      ))}
    </div>
  </section>

  <section class="my-16 chunky chunky--coral p-8 md:p-10">
    <div class="display text-3xl md:text-4xl mb-3">Got a pettier debate?</div>
    <p class="text-lg mb-5 max-w-xl">
      Open a PR with a new fight. I'll run it across all four models and add your name to the byline.
    </p>
    <a href="https://github.com/kmelve/petty-evals/blob/main/CONTRIBUTING.md" class="sticker">
      Submit via PR →
    </a>
  </section>
</Base>
