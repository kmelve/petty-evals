---
// Renders `backticked` spans in fight titles and prompts as <code>.
interface Props {
  text: string;
  codeClass?: string;
}
const { text, codeClass = 'rounded bg-zinc-100 px-1 font-mono text-[0.9em]' } = Astro.props;
const parts = text.split('`');
---
{parts.map((part, i) => (i % 2 === 1 ? <code class={codeClass}>{part}</code> : part))}
