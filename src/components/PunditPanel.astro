---
interface ModelQuote {
  id: string;
  displayName: string;
  provider: string;
  punditQuote: string | null;
}
interface Props {
  models: ModelQuote[];
}
const { models } = Astro.props;
const quoted = models.filter((m) => m.punditQuote);
---
<section class="mb-12">
  <h2 class="text-xs uppercase tracking-widest mb-3" style="color: var(--pe-muted);">Pundit panel</h2>
  <p class="text-sm mb-6 max-w-prose" style="color: var(--pe-muted);">
    After the runs were tallied, each model was shown the result and asked for a one-sentence reaction.
  </p>
  <div class="grid gap-4 md:grid-cols-2">
    {quoted.map((m) => (
      <article class="border p-4" style="border-color: var(--pe-rule);">
        <p class="text-sm leading-relaxed">"{m.punditQuote}"</p>
        <p class="mt-3 text-xs uppercase tracking-widest" style="color: var(--pe-muted);">
          — {m.displayName}, reviewer
        </p>
      </article>
    ))}
  </div>
</section>
